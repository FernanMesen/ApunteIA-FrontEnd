    <!-- Privacy & Export -->
    <string name="privacy_header">Proteção e Privacidade de Dados</string>
    <string name="privacy_subtitle">No ApunteIA levamos muito a sério a segurança e confidencialidade das suas notas e dados acadêmicos.</string>
    <string name="privacy_card1_title">Criptografia de dados em trânsito e em repouso</string>
    <string name="privacy_card1_desc">Todas as informações que você compartilha, incluindo notas digitalizadas e questionários, são protegidas com padrões robustos de criptografia.</string>
    <string name="privacy_card2_title">Uso de Inteligência Artificial</string>
    <string name="privacy_card2_desc">Suas notas são processadas por nossos modelos de IA exclusivamente para gerar resumos, auditorias e questionários de estudo. Não usamos suas informações pessoais para treinar modelos públicos sem seu consentimento.</string>
    <string name="privacy_card3_title">Direitos sobre seus dados</string>
    <string name="privacy_card3_desc">Você tem controle total sobre suas informações. Você pode exportar todos os seus dados ou excluir permanentemente sua conta nas configurações do perfil a qualquer momento.</string>
    <string name="privacy_preferences_header">Preferências de Privacidade</string>
    <string name="privacy_analytics_title">Análise de uso anônimo</string>
    <string name="privacy_analytics_desc">Ajude-nos a melhorar o aplicativo compartilhando estatísticas de uso sem dados pessoais.</string>
    <string name="privacy_personalization_title">Personalização inteligente</string>
    <string name="privacy_personalization_desc">Permitir que a IA adapte os questionários com base no seu histórico de estudos.</string>
    <string name="privacy_version">Versão da política de privacidade: 2.6.0\nAtualizado em novembro de 2026</string>

