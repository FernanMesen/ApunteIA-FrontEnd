      "responses": [
        {
          "uuid": "e6f9a489-0c85-41c7-a38f-eb4b571d59b8",
          "body": "[\r\n  {\"id\":1,\"text\":\"¿Qué término describe moléculas que son imágenes especulares entre sí pero no superponibles?\",\"options\":[\"Enantiómeros\",\"Diastereómeros\",\"Confórmeros\",\"Isótopos\"],\"correctAnswerIndex\":0,\"explanation\":\"Los enantiómeros son isómeros ópticos que son imágenes especulares no superponibles entre sí.\"},\r\n  {\"id\":2,\"text\":\"Una mezcla racémica contiene:\",\"options\":[\"Partes iguales de ambos enantiómeros\",\"Solo el enantiómero R\",\"Un solo compuesto aquiral\",\"Dos diastereómeros en proporción 3:1\"],\"correctAnswerIndex\":0,\"explanation\":\"Una mezcla racémica es una combinación 50:50 de ambos enantiómeros, por lo que no muestra rotación óptica neta.\"},\r\n  {\"id\":3,\"text\":\"¿Cuál es el ángulo de enlace aproximado en un átomo de carbono con hibridación sp3?\",\"options\":[\"90°\",\"120°\",\"109.5°\",\"180°\"],\"correctAnswerIndex\":2,\"explanation\":\"La geometría tetraédrica de la hibridación sp3 resulta en ángulos de enlace de 109.5°.\"},\r\n  {\"id\":4,\"text\":\"La regla de Markovnikov se aplica a:\",\"options\":[\"Combustión\",\"Adición electrofílica\",\"Sustitución nucleofílica\",\"Eliminación\"],\"correctAnswerIndex\":1,\"explanation\":\"La regla de Markovnikov predice el resultado de las reacciones de adición electrofílica a alquenos asimétricos.\"},\r\n  {\"id\":5,\"text\":\"¿Qué grupo funcional es característico de los alcoholes?\",\"options\":[\"-CHO\",\"-COOH\",\"-OH\",\"-NH2\"],\"correctAnswerIndex\":2,\"explanation\":\"El grupo hidroxilo (-OH) unido a un carbono saturado define a los alcoholes.\"}\r\n]",
          "latency": 0,
          "statusCode": 200,
          "label": "",
